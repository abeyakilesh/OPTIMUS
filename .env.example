# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# Get free-tier keys from the provider consoles — OmniRoute aggregates them.

MISTRAL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# OPTIMUS talks only to the local OmniRoute gateway, never to a provider.
ANTHROPIC_BASE_URL=http://localhost:20128
ANTHROPIC_AUTH_TOKEN=omniroute-local
OPENAI_BASE_URL=http://localhost:20128/v1

# Gates /chat and /api/chat (proxy.ts). Both required — the login route
# fails closed if either is unset, on purpose. Not per-user accounts, one
# shared password while it's just you.
OPTIMUS_PASSWORD=
OPTIMUS_SESSION_SECRET=
