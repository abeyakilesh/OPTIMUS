# Copy to `.env` and fill in. `.env` is gitignored; this file is not.

# ── provider keys ──────────────────────────────────────────────────────────
# ⚠️ These are NOT read by OmniRoute. In v3.8.50, MISTRAL_API_KEY and
# GROQ_API_KEY sit in OmniRoute's own DOC_ONLY_ALLOWLIST under "Removed /
# Dead Variables" (scripts/check/check-env-doc-sync.mjs) and GEMINI_API_KEY is
# in LEGACY_ENV_KEYS. They have no runtime hook there — no directory, and no
# shell export, changes that. OmniRoute keeps provider credentials in its own
# SQLite, registered over its admin API; see
# kernel/capabilities/omniroute/setup-local-ollama-provider.sh.
#
# What DOES read them: OPTIMUS's own /api/providers/status route, server-side,
# to report each provider's live status at /settings/providers. Keys are
# masked before anything reaches a client. Leave them blank and that page
# reports "not set" honestly — nothing else breaks.
MISTRAL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ── how OPTIMUS reaches models ─────────────────────────────────────────────
# Missions route through the local OmniRoute gateway. llm.chat's isolation is
# loopback-only, so a remote baseUrl is refused by the manifest before the
# capability sees it (see ADR-0006).
ANTHROPIC_BASE_URL=http://localhost:20128
OPENAI_BASE_URL=http://localhost:20128/v1

# ⚠️ This must be a REAL OmniRoute API key, not an invented string. A previous
# version of this file suggested "omniroute-local" and claimed any non-empty
# value works for a local gateway. It does not: OmniRoute validates against
# its own database (validateApiKey, src/lib/db/apiKeys) and answers
# `Invalid API key`. Mint one:
#
#   curl -c /tmp/or -X POST http://127.0.0.1:20128/api/auth/login \
#     -H 'Content-Type: application/json' -d '{"password":"CHANGEME"}'
#   curl -b /tmp/or -X POST http://127.0.0.1:20128/api/keys \
#     -H 'Content-Type: application/json' -d '{"name":"optimus-local"}'
ANTHROPIC_AUTH_TOKEN=

# Optional. Only needed for the gateway's own request counts on
# /settings/providers — they require a dashboard session, not an API key.
# Left blank, that panel says why it is empty instead of showing zeroes.
OMNIROUTE_PASSWORD=

# Gates /chat, /settings and /api/* (proxy.ts). Both required — the login
# route fails closed if either is unset, on purpose. Not per-user accounts,
# one shared password while it's just you.
OPTIMUS_PASSWORD=
OPTIMUS_SESSION_SECRET=
