# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# Get free-tier keys from the provider consoles — OmniRoute aggregates them.

MISTRAL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# OPTIMUS talks only to the local OmniRoute gateway, never to a provider.
ANTHROPIC_BASE_URL=http://localhost:20128
ANTHROPIC_AUTH_TOKEN=omniroute-local
OPENAI_BASE_URL=http://localhost:20128/v1
